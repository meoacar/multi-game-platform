# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_NAME="Takım Sistemi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://squadbul.com

# ==============================================
# MULTI-GAME PLATFORM SETTINGS
# ==============================================
APP_DOMAIN=squadbul.com
MAIN_DOMAIN=squadbul.com
APP_URL_PROTOCOL=https

# Game Settings
DEFAULT_GAME=pubg
MULTI_GAME_ENABLED=true
GAME_SWITCHING_ENABLED=true
SUBDOMAIN_ENABLED=true

# Game Cache Settings (Production: Redis kullanılmalı)
GAME_CACHE_ENABLED=true
GAME_CACHE_TTL=3600

# Cross-Game Features
CROSS_GAME_MESSAGING=true
CROSS_GAME_FRIENDSHIPS=true

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================
LOG_SLOW_QUERIES=true
SLOW_QUERY_THRESHOLD=1000
DB_SLOW_QUERY_THRESHOLD=1000

# Query Cache (Production: Redis önerilir)
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# ==============================================
# LOCALIZATION
# ==============================================
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# ==============================================
# MAINTENANCE & WORKERS
# ==============================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ==============================================
# LOGGING
# ==============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ==============================================
# DATABASE SETTINGS
# ==============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pubg_community
DB_USERNAME=root
DB_PASSWORD=

# Database Connection Pool (Production)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==============================================
# SESSION SETTINGS (Production: Redis önerilir)
# ==============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.squadbul.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ==============================================
# SANCTUM SETTINGS (Cross-Subdomain Support)
# ==============================================
SANCTUM_STATEFUL_DOMAINS=squadbul.com,*.squadbul.com

# ==============================================
# CACHE SETTINGS (Production: Redis önerilir)
# ==============================================
CACHE_DRIVER=redis
CACHE_PREFIX=takimsistemi_cache

# ==============================================
# QUEUE SETTINGS (Production: Redis önerilir)
# ==============================================
QUEUE_CONNECTION=redis

# ==============================================
# REDIS SETTINGS
# ==============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# Redis Connection Pool
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# ==============================================
# BROADCAST SETTINGS
# ==============================================
BROADCAST_CONNECTION=redis
BROADCAST_DRIVER=redis

# ==============================================
# FILESYSTEM SETTINGS
# ==============================================
FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=local

# AWS S3 (Production için önerilir)
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# ==============================================
# MAIL SETTINGS
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@squadbul.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# MEMCACHED SETTINGS (Alternatif Cache)
# ==============================================
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ==============================================
# VITE SETTINGS
# ==============================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ==============================================
# FIREBASE CLOUD MESSAGING (FCM)
# ==============================================
FCM_SERVER_KEY=
FCM_SENDER_ID=

# ==============================================
# PUSHER SETTINGS (Real-time Broadcasting)
# ==============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# ==============================================
# SECURITY SETTINGS
# ==============================================
# Rate Limiting
RATE_LIMIT_API=60
RATE_LIMIT_WEB=1000

# CORS Settings
CORS_ALLOWED_ORIGINS=https://squadbul.com,https://*.squadbul.com

# ==============================================
# MONITORING & ANALYTICS
# ==============================================
# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics
GOOGLE_ANALYTICS_ID=

# ==============================================
# BACKUP SETTINGS
# ==============================================
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

# ==============================================
# CDN SETTINGS
# ==============================================
CDN_URL=
CDN_ENABLED=false

# ==============================================
# OPTIMIZATION FLAGS
# ==============================================
# Production optimizations
OPTIMIZE_ROUTES=true
OPTIMIZE_CONFIG=true
OPTIMIZE_VIEWS=true

# Asset optimization
ASSET_MINIFICATION=true
IMAGE_OPTIMIZATION=true

# ==============================================
# DEBUG & DEVELOPMENT (Production'da false)
# ==============================================
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
QUERY_LOG_ENABLED=false
